# ---------------------------------------------------------------------------
# Main
# ---------------------------------------------------------------------------
def main() -> None:
    global is_symlink_dev

    # Check for -d / --debug anywhere in args and remove it
    args = sys.argv[1:]
    debug = False
    if "-d" in args:
        debug = True
        args.remove("-d")
    if "--debug" in args:
        debug = True
        args.remove("--debug")

    if debug:
        logging.basicConfig(level=TRACE, format="%(levelname)s: %(message)s")
    else:
        logging.basicConfig(level=logging.INFO, format="%(levelname)s: %(message)s")

    # Symlink check
    is_symlink_dev = Path(".server").is_symlink() or Path("./pipeline-repo/.server").is_symlink()
    if is_symlink_dev:
        print("Detected a symlink on .server folder: this is a development setup!")

    # Prerequisite checks
    if not command_exists("docker"):
        color_print(RED, "Docker and docker compose plugin are required to run the pipeline engine.")
        sys.exit(1)
    if not command_exists("git"):
        color_print(RED, "Git is required to run the latest version of the pipeline engine.")
        sys.exit(1)

    if not args:
        show_help()
        sys.exit(1)

    command = args[0]

    if command == "help":
        show_help()
    elif command == "checkout":
        if len(args) < 2:
            print("Error: checkout requires a branch name.")
            sys.exit(1)
        cmd_checkout(args[1])
    elif command == "up":
        prepare_commands()
        cmd_up(args[1:])
    elif command == "down":
        prepare_commands()
        cmd_down()
    elif command == "validate":
        prepare_commands()
        cmd_validate()
    elif command == "command":
        prepare_commands()
        assert_success(docker_compose(*args[1:]))
    elif command == "purge":
        print("Deprecated: Purge is now an alias to the clean command.")
        prepare_commands()
        cmd_clean()
        color_print(GREEN, "Clean complete.")
    elif command == "clean":
        prepare_commands()
        cmd_clean()
        color_print(GREEN, "Clean complete.")
    elif command == "version":
        cmd_version()
    elif command == "licence":
        cmd_licence()
    else:
        show_help()
        sys.exit(1)


if __name__ == "__main__":
    main()
