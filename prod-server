# ---------------------------------------------------------------------------
# Constants
# ---------------------------------------------------------------------------
RED = "\033[31m"
GREEN = "\033[32m"
YELLOW = "\033[33m"
BOLD = "\033[1m"
ENDCOLOR = "\033[0m"

COPYRIGHT_RANGE = "2021-2026"

# ---------------------------------------------------------------------------
# Logging setup – the *trace* level replaces the old per-image log files.
# Activate with -d / --debug on the command-line.
# ---------------------------------------------------------------------------
TRACE = 5  # custom log level, below DEBUG
logging.addLevelName(TRACE, "TRACE")


def _trace(self, message, *args, **kwargs):
    if self.isEnabledFor(TRACE):
        self._log(TRACE, message, args, **kwargs)


logging.Logger.trace = _trace  # type: ignore[attr-defined]
logger = logging.getLogger("prod-server")

# ---------------------------------------------------------------------------
# Global state
# ---------------------------------------------------------------------------
n_errors = 0
is_symlink_dev = False
compose_files: list[str] = []
docker_suffix = "latest"
script_dir = str(Path(__file__).resolve().parent)
repo_dir = ""  # pipeline-repo folder; set by prepare_commands()


# ---------------------------------------------------------------------------
# Helpers
# ---------------------------------------------------------------------------
def color_print(color: str, text: str) -> None:
    print(f"{color}{text}{ENDCOLOR}")


def run(
    cmd: list[str] | str,
    *,
    check: bool = False,
    capture: bool = False,
    shell: bool = False,
    cwd: str | None = None,
    suppress_stderr: bool = False,
) -> subprocess.CompletedProcess:
    """Thin wrapper around subprocess.run."""
    stderr = subprocess.DEVNULL if suppress_stderr else None
    stdout = subprocess.PIPE if capture else None
    return subprocess.run(
        cmd,
        check=check,
        stdout=stdout,
        stderr=stderr,
        text=True,
        shell=shell,
        cwd=cwd,
    )


def assert_success(result: subprocess.CompletedProcess) -> None:
    if result.returncode != 0:
        color_print(RED, "FAILED")
        sys.exit(1)


def flag_errors(result: subprocess.CompletedProcess) -> None:
    global n_errors
    if result.returncode != 0:
        color_print(RED, "FAILED")
        n_errors += 1


def exclude_strings(lines: list[str], pattern: str) -> list[str]:
    """Return *lines* that do **not** match the regex *pattern*."""
    regex = re.compile(pattern)
    return [line for line in lines if not regex.search(line)]


def command_exists(name: str) -> bool:
    return shutil.which(name) is not None


# ---------------------------------------------------------------------------
# Docker-compose helper
# ---------------------------------------------------------------------------
def _compose_cmd(*extra_args: str) -> list[str]:
    """Build the full docker compose command list."""
    cmd = ["docker", "compose"]
    for f in compose_files:
        cmd += ["-f", f]
    cmd += ["--env-file", "runner.env", "--env-file", ".server/.prod-paths.env"]
    cmd += list(extra_args)
    return cmd


def docker_compose(
    *extra_args: str,
    capture: bool = False,
    capture_all: bool = False,
) -> subprocess.CompletedProcess:
    """Build and run the full docker compose command.

    *capture*     – capture stdout only (stderr goes to terminal).
    *capture_all* – capture both stdout **and** stderr.
    All compose calls run with ``cwd=repo_dir`` so that the relative
    env-file paths (``runner.env``, ``.server/.prod-paths.env``) resolve
    correctly against the pipeline-repo folder.
    """
    cmd = _compose_cmd(*extra_args)
    logger.trace("docker_compose cmd: %s  (cwd=%s)", " ".join(cmd), repo_dir)  # type: ignore[attr-defined]
    if capture_all:
        return subprocess.run(cmd, capture_output=True, text=True, cwd=repo_dir or None)
    return run(cmd, capture=capture, cwd=repo_dir or None)


# ---------------------------------------------------------------------------
# check_for_updates – replaces the bash checkForUpdates + xargs parallelism
# ---------------------------------------------------------------------------
def _check_single_image(image: str) -> str | None:
    """Return the image name if it needs updating, else *None*.

    All the log-file writes from the bash version are replaced by
    logger.log(TRACE, …) calls.
    """

    # --- local digest ---
    logger.log(TRACE, "Inspecting local image: %s", image)
    result = run(
        ["docker", "image", "inspect", "--format", "{{index .Id}}", image],
        capture=True,
        suppress_stderr=True,
    )
    local_digest = result.stdout.strip()
    # The bash version did `cut -d '@' -f2`; .Id already is the digest.
    if "@" in local_digest:
        local_digest = local_digest.split("@", 1)[1]

    logger.log(TRACE, "Local digest for %s: %s", image, local_digest)

    if not local_digest:
        logger.log(TRACE, "Not available locally: %s", image)
        return image  # not available locally

    # --- remote digest ---
    result = run(
        ["docker", "manifest", "inspect", "-v", image],
        capture=True,
        suppress_stderr=True,
    )
    remote_manifest = result.stdout.strip()
    logger.log(TRACE, "Remote manifest for %s: %s", image, remote_manifest[:200])

    if local_digest not in remote_manifest:
        logger.log(TRACE, "Local digest does not match remote digest for %s", image)
        return image

    logger.log(TRACE, "Local digest matches: %s up to date", image)

    # --- container check ---
    result = run(
        ["docker", "container", "ls", "-a", "--format", "{{.Image}}"],
        capture=True,
    )
    containers = result.stdout.strip().splitlines()
    if image not in containers:
        logger.log(TRACE, "No container exists for %s", image)
        return image

    logger.log(TRACE, "Container exists for %s", image)
    return None


def check_for_updates(images: list[str]) -> list[str]:
    """Return a list of images that need updating.

    Uses a thread-pool (like the bash ``xargs -P8``) for parallelism.
    """
    needs_update: list[str] = []
    with ThreadPoolExecutor(max_workers=8) as pool:
        futures = {pool.submit(_check_single_image, img): img for img in images}
        for future in as_completed(futures):
            result = future.result()
            if result is not None:
                needs_update.append(result)
    return needs_update


