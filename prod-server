def show_help() -> None:
    print(
        """\
Usage: ./prod-server COMMAND [ARGS...]

Commands:
    help                 Display this help
    checkout [BRANCH]    Checkout config files from given branch of pipeline engine repo.
    up [-y]              Start the server, accessible in http://localhost
                         Use -y or --yes to skip confirmation prompts (for automation)
    down                 Stops the server
    validate             Run basic validation on pipelines and scripts.
    clean                Removes the docker containers of all services and the volume
                         used to store the conda sub-environment info.
                         This is useful in development switching from prod to dev server,
                         in cases when we get the following error:
                         "The container name ... is already in use by container ..."
    version              Display the current version of the server
    licence              Display the licence information
    command [ARGS...]    Run an arbitrary docker compose command,
                         such as (pull|run|up|down|build|logs)

Options:
    -d, --debug          Enable debug (trace) logging"""
    )


def prepare_commands() -> None:
    global compose_files, docker_suffix, is_symlink_dev, repo_dir

    # The pipeline-repo folder is the parent of the directory that
    # contains this script (.server/ in production).  All docker compose
    # commands must run from there so that relative env-file paths
    # (runner.env, .server/.prod-paths.env) resolve correctly.
    repo_dir = str(Path(script_dir).parent)
    logger.log(TRACE, "repo_dir: %s", repo_dir)

    # Docker GID
    docker_gid = ""
    try:
        docker_gid = str(grp.getgrnam("docker").gr_gid)
    except (KeyError, AttributeError):
        pass

    os.environ["DOCKER_GID"] = docker_gid

    print(f"Server config location: {script_dir}")

    # Branch detection
    if is_symlink_dev:
        branch = run(["git", "branch", "--show-current"], capture=True).stdout.strip()
    else:
        fetch_line = run(
            ["git", "-C", script_dir, "config", "remote.origin.fetch"],
            capture=True,
        ).stdout.strip()
        # sed 's/.*remotes\/origin\///'
        branch = re.sub(r".*/remotes/origin/", "", fetch_line) if fetch_line else ""

    if branch == "*":
        branch = run(["git", "branch", "--show-current"], capture=True).stdout.strip()

    if branch.endswith("staging"):
        docker_suffix = branch
        os.environ["DOCKER_SUFFIX"] = docker_suffix
        print(f'Using staging containers with tag "{branch}"')
    elif branch == "edge":
        docker_suffix = "edge"
        os.environ["DOCKER_SUFFIX"] = docker_suffix
        print("Using edge releases: you'll be up to date with the latest possible server.")
    else:
        docker_suffix = "latest"
        os.environ["DOCKER_SUFFIX"] = docker_suffix
        print("Using default branch.")

    if not docker_gid:
        os.environ["DOCKER_GID"] = ""
        os.environ["MY_UID"] = ""
    else:
        os.environ["MY_UID"] = str(os.getuid())

    # Compose files
    compose_files = [
        ".server/compose.yml",
        ".server/compose.prod.yml",
        "compose.env.yml",
    ]

    # Apple M-series chip detection
    if platform.system() == "Darwin":
        result = run(
            ["sysctl", "-n", "machdep.cpu.brand_string"],
            capture=True,
            suppress_stderr=True,
        )
        mac_cpu = result.stdout.strip()
        if mac_cpu and re.match(r"^Apple M[1-9]", mac_cpu):
            print("Apple M* chip detected")
            compose_files.append(".server/compose.apple.yml")


def cmd_validate() -> None:
    global n_errors
    cwd = os.getcwd()

    print("Running basic validation of pipelines and scripts...")

    print("Checking for duplicate descriptions in scripts...")
    os.chdir("scripts")
    flag_errors(run(["../.server/.github/findDuplicateDescriptions.sh"]))
    os.chdir(cwd)

    print("Validating script metadata against schema...")
    flag_errors(
        run(
            [
                "docker",
                "run",
                "--rm",
                "--name",
                "biab-yaml-validator",
                "-v",
                f"{cwd}/scripts:/scripts",
                "-v",
                f"{cwd}/.server/.github/:/.github",
                "navikt/yaml-validator:v4",
                ".github/scriptValidationSchema.yml",
                "scripts/",
                "no",
                ".yml",
            ]
        )
    )

    print("Checking for duplicate ids in pipelines...")
    os.chdir("pipelines")
    flag_errors(run(["../.server/.github/findDuplicateIds.sh"]))
    os.chdir(cwd)

    print("Validating pipeline structure")
    flag_errors(
        docker_compose(
            "run",
            "script-server",
            "java",
            "-cp",
            "biab-script-server.jar",
            "org.geobon.pipeline.Validator",
        )
    )

    print("Validating pipeline metadata")
    if not command_exists("python3"):
        color_print(RED, "Python is required to validate the pipeline metadata.")
        sys.exit(1)
    if not command_exists("pip"):
        color_print(RED, "pip is required to validate the pipeline metadata.")
        sys.exit(1)

    run(["pip", "install", "pyyaml", "cerberus"])
    schema = f"{cwd}/.server/.github/validateCerberusSchema.py"
    validation_script = f"{cwd}/.server/.github/pipelineValidationSchema.yml"
    print(f"Using schema: {schema}")
    print(f"Using validation script: {validation_script}")
    os.chdir(f"{cwd}/pipelines")
    flag_errors(run(["python3", schema, validation_script]))
    os.chdir(cwd)

    if n_errors == 0:
        color_print(GREEN, "Validation complete.")
    else:
        color_print(RED, "Errors occured during validation. Check logs above.")
        sys.exit(1)


def cmd_checkout(branch_name: str) -> None:
    branch = f"origin/{branch_name}"
    print(f"Updating server configuration from {branch}...")

    files_assert = [
        ".prod-paths.env",
        "compose.yml",
        "compose.prod.yml",
        "compose.apple.yml",
        ".github/findDuplicateDescriptions.sh",
        ".github/findDuplicateIds.sh",
        ".github/scriptValidationSchema.yml",
        ".github/pipelineValidationSchema.yml",
        ".github/validateCerberusSchema.py",
        "http-proxy/conf.d-prod/ngnix.conf",
        "script-stubs",
    ]
    for f in files_assert:
        assert_success(run(["git", "checkout", branch, "--", f]))

    # version.txt: don't assert — only informative
    run(["git", "checkout", branch, "--", "version.txt"])

    color_print(GREEN, "Server configuration updated.")


def cmd_up(extra_args: list[str]) -> None:
    auto_yes = "-y" in extra_args or "--yes" in extra_args

    # No need to os.chdir – docker_compose() always runs from repo_dir.

    print("Checking requirements...")
    result = docker_compose("ps", capture_all=True)
    output = (result.stdout or "") + (result.stderr or "")

    if 'service "runner-conda" has neither an image nor a build context specified' in output:
        color_print(
            RED,
            f"{BOLD}Cannot start server until branch is updated:{ENDCOLOR}",
        )
        print(f"{BOLD}BON in a Box now supports conda dependencies!")
        print(
            f"{BOLD}Update your development branch or fork with the main branch "
            f"from GEO-BON/bon-in-a-box-pipelines and launch the server again{ENDCOLOR}"
        )
        print()
        color_print(RED, f"{BOLD}Workaround for legacy branches:{ENDCOLOR}")
        print("Run the server with the following command")
        print("    ./server-up.sh pre-conda-staging")
        sys.exit(1)

    elif "ghcr.io/geo-bon/bon-in-a-box-pipeline-engine/gateway" in output:
        color_print(RED, "BON in a Box is already running.")
        sys.exit(1)

    # Check for legacy Docker Hub images
    images_result = docker_compose("config", "--images", capture=True)
    images_text = images_result.stdout.strip()
    images = [i for i in images_text.splitlines() if i.strip()]

    if any("geobon/bon-in-a-box:runner" in i for i in images):
        color_print(
            YELLOW,
            "Legacy Docker Hub images detected in your configuration.\n"
            "Please update your branch by merging the changes from the main branch "
            "to use the images from GitHub Packages (ghcr.io).",
        )
        print("This can be done visually or on the command line with the following commands:")
        print("    git fetch")
        print("    git merge origin/main")
        color_print(RED, "FAILED")
        sys.exit(1)

    print("Building (if necessary)...")
    assert_success(docker_compose("build"))

    containers_to_discard: list[str] = []

    # Check if already installed
    img_ls = run(
        ["docker", "image", "ls", "--format", "{{.Repository}}"],
        capture=True,
    )
    installed_repos = img_ls.stdout.strip().splitlines()
    has_ghcr = any("ghcr.io/geo-bon/bon-in-a-box-pipeline-engine/" in r for r in installed_repos)

    if not has_ghcr:
        # Check legacy
        has_legacy = any("geobon/bon-in-a-box" in r for r in installed_repos)
        if has_legacy:
            color_print(YELLOW, "Docker Hub containers found: cleaning up before installing the new version.")
            color_print(YELLOW, "Please be patient while we save some disk space: this may take a while.")

            cmd_clean()

            print("Removing obsolete containers...")
            container_ls = run(
                ["docker", "container", "ls", "-a", "--format", "{{.Image}} {{.ID}}"],
                capture=True,
            )
            for line in container_ls.stdout.strip().splitlines():
                if "geobon/bon-in-a-box:" in line:
                    cid = line.split()[-1]
                    run(["docker", "container", "rm", cid])

            print("Removing obsolete images...")
            image_ls = run(
                ["docker", "image", "ls", "--format", "{{.Repository}}:{{.Tag}} {{.ID}}"],
                capture=True,
            )
            for line in image_ls.stdout.strip().splitlines():
                if line.startswith("geobon/bon-in-a-box"):
                    iid = line.split()[-1]
                    run(["docker", "image", "rm", iid])

            print("Removing obsolete volumes...")
            run(
                [
                    "docker",
                    "volume",
                    "rm",
                    "conda-dir-dev",
                    "conda-cache-dev",
                    "conda-env-yml",
                    "r-libs-user-dev",
                ],
                suppress_stderr=True,
            )
            color_print(GREEN, "Clean complete.")

        print("Installing...")
        assert_success(docker_compose("pull"))

    else:
        # Already installed -- check for updates
        print("Checking for updates to docker images...")

        services_result = docker_compose("config", "--services", capture=True)
        services = [s for s in services_result.stdout.strip().splitlines() if s.strip()]

        saved_container_regex = re.compile(r"^(runner-conda|runner-julia)$")
        saved_container_services = ["runner-conda", "runner-julia"]
        other_services = [s for s in services if not saved_container_regex.match(s)]

        # Exclude images we don't want to check
        excluded_images_pattern = r"ghcr\.io/developmentseed/titiler:.*"
        images_to_check = exclude_strings(images, excluded_images_pattern)
        images_to_update = check_for_updates(images_to_check)

        saved_regex = re.compile(r"(runner-conda|runner-julia)")
        containers_to_discard = [i for i in images_to_update if saved_regex.search(i)]

        if images_to_update:
            print("Updates found.")
            if containers_to_discard:
                color_print(YELLOW, "This update will discard the following runner containers: ")
                for container in containers_to_discard:
                    container_no_tag = container.split(":")[0]
                    color_print(YELLOW, f" - {container_no_tag}")
                color_print(
                    YELLOW,
                    "This means that conda environments and dependencies installed at runtime will need to be reinstalled.",
                )

            if auto_yes:
                choice = "y"
            else:
                choice = input("Do you want to update? (Y/n): ").strip()

            if not choice or choice.lower() == "y":
                assert_success(docker_compose("pull"))
            else:
                images_to_update = []
                containers_to_discard = []
        else:
            print("No updates found.")

    print("Starting the server...")

    saved_container_services = ["runner-conda", "runner-julia"]
    services_result = docker_compose("config", "--services", capture=True)
    services = [s for s in services_result.stdout.strip().splitlines() if s.strip()]
    saved_container_regex_filter = re.compile(r"^(runner-conda|runner-julia)$")
    other_services = [s for s in services if not saved_container_regex_filter.match(s)]

    combined_output = ""
    combined_rc = 0

    for service in saved_container_services:
        flag = "--no-recreate"
        if any(service in c for c in containers_to_discard):
            print(f"  Discarding {service} runner")
            flag = "--force-recreate"

        result = docker_compose("up", "-d", flag, service, capture_all=True)
        combined_output += (result.stdout or "") + (result.stderr or "")
        if result.returncode != 0:
            combined_rc = 1

    # Start the rest
    result = docker_compose("up", "-d", *other_services, capture_all=True)
    combined_output += (result.stdout or "") + (result.stderr or "")
    if result.returncode != 0:
        combined_rc = 1

    if "is already in use by container" in combined_output:
        print("A container name conflict was found, we will clean and try again.")
        cmd_clean()
        print("Starting the server after a clean...")
        assert_success(docker_compose("up", "-d"))
    elif combined_rc != 0:
        print(combined_output)
        color_print(RED, "FAILED")
        sys.exit(1)

    color_print(GREEN, "Server is running.")


def cmd_down() -> None:
    print("Stopping the servers...")
    assert_success(docker_compose("stop"))
    color_print(GREEN, "Server has stopped.")


def cmd_clean() -> None:
    print("Removing docker containers...")
    result = subprocess.run(
        [
            "docker",
            "container",
            "rm",
            "biab-gateway",
            "biab-script-server",
            "biab-python-api",
            "biab-runner-conda",
            "biab-runner-julia",
        ],
        capture_output=True,
        text=True,
    )
    output = (result.stdout or "") + (result.stderr or "")
    if "container is running" in output:
        color_print(RED, "Cannot clean while BON in a Box is running.")
        sys.exit(1)


